(rule
 (alias fuzzer)
 (mode promote)
 (targets state.dat report.md)
 (action
  (run
   %{bin:ocamlgrammarfuzzer}
   --ocamlformat-check
   --exhaust
   --oxcaml
   --comments
   --ocamlformat
   %{exe:../../bin/ocamlformat/main.exe}
   --track-regressions-in
   state.dat
   --save-report-to
   report.md)))
